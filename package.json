{
  "name": "template-claude-code-ts",
  "version": "1.0.0",
  "private": true,
  "description": "Universal adopter CLI for code assistant templates.",
  "type": "commonjs",
  "bin": {
    "adopt": "dist/adopt.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/adopt.js",
    "adopt": "npm run build && node dist/adopt.js",
    "adopt:win": "powershell -ExecutionPolicy Bypass -File ./adopt.ps1",
    "test:smoke:gemini": "bash ./scripts/smoke-antigravity.sh gemini",
    "test:smoke:antigravity": "bash ./scripts/smoke-antigravity.sh antigravity"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
